PORT=3000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here

# RN19: bloqueio temporário após N falhas consecutivas de login
LOGIN_MAX_ATTEMPTS=3
LOGIN_BLOCK_MINUTES=15

# SQLite via Drizzle ORM (better-sqlite3). Opcional — padrão: ./database.sqlite
DATABASE_PATH=./database.sqlite

# SMTP Configuration for Password Recovery
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=no-reply@agrostand.com
